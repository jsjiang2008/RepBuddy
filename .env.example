# Copy this example into your local settings file and enter your PostgreSQL password.
# Native PostgreSQL runs as a Windows service. Normal app startup does not need Docker.
# See README.md to create the repbuddy account and database first.
DATABASE_URL=postgresql://repbuddy:choose_a_password@127.0.0.1:5432/repbuddy

# To use Docker, replace the connection above with the example below.
# Then use the Docker startup command described in the project guide.
# These bundled credentials are only for the local development database.
# DATABASE_URL=postgresql://repbuddy:repbuddy_local@127.0.0.1:5433/repbuddy

# Optional, use a separate PostgreSQL database for integration tests.
# Tests create and remove their own isolated schema inside this database.
# TEST_DATABASE_URL=postgresql://repbuddy:choose_a_password@127.0.0.1:5432/repbuddy_test
